# EXAMPLE ONLY — never commit .env or real keys/passwords
# Permissions of live file: 600; keep outside public document roots.
DJANGO_SECRET_KEY=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
DJANGO_DB_PATH=/home2/gfrancossh/galiel/db.sqlite3
DJANGO_PRIVATE_MEDIA_ROOT=/home2/gfrancossh/galiel-private-files

# SMTP SSL (HostGator; no secret credentials in Git)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=gator3232.hostgator.com
DJANGO_EMAIL_PORT=465
DJANGO_EMAIL_HOST_USER=registration@galiel.wardenclyffefirm.com
DJANGO_EMAIL_HOST_PASSWORD=REPLACE_IN_PRIVATE_ENV_ONLY
DJANGO_EMAIL_USE_TLS=False
DJANGO_EMAIL_USE_SSL=True
DJANGO_DEFAULT_FROM_EMAIL=Galiel <registration@galiel.wardenclyffefirm.com>

# Optional feature/service integrations. Do not enable Stripe before acceptance testing.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
